---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageSeo } from "../seo/siteSeo.js";
import { absoluteUrl, buildFaqSchema, buildWebPageSchema } from "../seo/jsonLd.js";

const seo = pageSeo.playGame;
const gameHub = "https://tadcmindgames.org";

const gameTags = [
  "Fan Made",
  "Horror VN",
  "Browser H5",
  "Multiple Endings",
  "Story Rich",
  "The Amazing Digital Circus",
];

const routeHubLinks = [
  {
    tag: "Route",
    label: "Walkthrough",
    href: `${gameHub}/walkthrough`,
    desc: "Run order, replay plan, and safe route logic for TADC Mind Games.",
  },
  {
    tag: "Five",
    label: "Endings",
    href: `${gameHub}/endings`,
    desc: "Known endings and the order most players chase them.",
  },
  {
    tag: "Risk",
    label: "Choices",
    href: `${gameHub}/choices`,
    desc: "Trust, doubt, help, follow, and delay — what each mood does.",
  },
  {
    tag: "Cast",
    label: "Characters",
    href: `${gameHub}/characters`,
    desc: "Caine, Pomni, and Kinger route signals on the dedicated game site.",
  },
  {
    tag: "More",
    label: "Related Games",
    href: `${gameHub}/related-games`,
    desc: "Short horror games to try after TADC Mind Games.",
  },
  {
    tag: "Build",
    label: "Updates",
    href: `${gameHub}/updates`,
    desc: "Version notes and route page status from the game hub.",
  },
];

const quickSteps = [
  {
    number: "01",
    title: "Play one blind run",
    text: "Do not chase every ending immediately. Finish one route so the first ending lands properly and you learn the game's pressure rhythm.",
  },
  {
    number: "02",
    title: "Pick a replay mood",
    text: "Choose trust, doubt, panic, curiosity, or delay before your next run starts — then stay with that mood.",
  },
  {
    number: "03",
    title: "Change the sharpest answer",
    text: "Return to the choice that felt most uncomfortable and answer with the opposite emotional logic on replay.",
  },
  {
    number: "04",
    title: "Track the ending pull",
    text: "If the scene changes after a consistent mood, stay with it until the ending path becomes clear.",
  },
];

const routeBranches = [
  { label: "Trust Caine", href: `${gameHub}/choices` },
  { label: "Question Caine", href: `${gameHub}/choices` },
  { label: "Help Pomni", href: `${gameHub}/choices` },
  { label: "Follow Kinger", href: `${gameHub}/choices` },
];

const endings = [
  { name: "Caine Compliance", focus: "Trust Caine", danger: "High", cue: "Obedience, praise, controlled answers" },
  { name: "Caine Defiance", focus: "Question Caine", danger: "High", cue: "Suspicion, refusal, direct challenge" },
  { name: "Pomni Panic", focus: "Help Pomni", danger: "Medium", cue: "Escape pressure, fear, emotional support" },
  { name: "Kinger Clue", focus: "Follow Kinger", danger: "Medium", cue: "Odd hints, slower routes, strange room details" },
  { name: "Mixed Unknown", focus: "Blend choices", danger: "Unknown", cue: "Delay, mixed moods, less obvious answers" },
];

const choiceSignals = [
  { title: "Trust", signal: "Caine control rises", when: "When you want polished danger", text: "Obedience and praise push the run toward Caine compliance pressure." },
  { title: "Doubt", signal: "Defiance pressure rises", when: "When you want sharper reactions", text: "Suspicion and refusal steer toward Caine defiance and unstable scenes." },
  { title: "Help", signal: "Pomni panic shifts", when: "When you want emotional branches", text: "Support and escape pressure open Pomni panic routes — not always the kindest line." },
  { title: "Follow", signal: "Kinger clues appear", when: "When you want strange detours", text: "Patience with odd room details can unlock Kinger clue language." },
  { title: "Delay", signal: "Uncertainty builds", when: "When every answer feels unsafe", text: "Mixed or delayed choices feed the unknown ending pull." },
];

const characterRoutes = [
  {
    name: "Caine",
    label: "Control Route",
    image: "/images/site/cast-stage.png",
    alt: "Caine route context for TADC Mind Games",
    canonHref: "/characters/caine",
    gameHref: `${gameHub}/characters`,
    text: "The strongest pressure point in the game. Trusting him, praising him, or pushing back can all send the scene toward different outcomes.",
  },
  {
    name: "Pomni",
    label: "Panic Route",
    image: "/images/characters/pomni.png",
    alt: "Pomni route context for TADC Mind Games",
    canonHref: "/characters/pomni",
    gameHref: `${gameHub}/characters`,
    text: "Pomni choices lean into panic, escape, and emotional pressure. Helping her is not always as simple as choosing the kindest line.",
  },
  {
    name: "Kinger",
    label: "Clue Route",
    image: "/images/episodes/episode-03.jpg",
    alt: "Kinger route context for TADC Mind Games",
    canonHref: "/characters/kinger",
    gameHref: `${gameHub}/characters`,
    text: "Kinger's path is stranger and slower. Follow odd hints, watch the room, and expect clues that feel more unsettling than obvious.",
  },
];

const faqItems = [
  {
    question: "Can I play TADC Mind Games online on this page?",
    answer:
      "Yes. Press Play Game above to load the browser embed on theamazingdigitalcircus.org. For the full route hub with walkthrough, endings, and choice pages, visit tadcmindgames.org.",
  },
  {
    question: "How many endings are in TADC Mind Games?",
    answer:
      "The current build has five ending paths to chase: Caine compliance, Caine defiance, Pomni panic, Kinger clue, and mixed unknown. See the ending tracker below or the endings hub on tadcmindgames.org.",
  },
  {
    question: "Which characters appear in the game?",
    answer:
      "The visible cast centers on Caine, Pomni, and Kinger. Use the TADC Mind Games characters page for route roles and ending links, and our canon character profiles for the official animation.",
  },
  {
    question: "Where should I go after my first ending?",
    answer:
      "Open the endings hub on tadcmindgames.org if you want another outcome, or the choices page if you remember the answer that made the route feel dangerous.",
  },
  {
    question: "Is TADC Mind Games official?",
    answer:
      "No. TADC Mind Games is a fan-made horror visual novel inspired by The Amazing Digital Circus. It is not produced by GLITCH Productions or Gooseworx. This page is an unofficial fan resource on theamazingdigitalcircus.org.",
  },
  {
    question: "Which TADC episodes help before playing?",
    answer:
      "Pilot for Caine and Pomni, Candy Carrier Chaos for identity pressure, and Mildenhall Manor for Kinger. Pair episodes with our Explained videos for canon context before fan-game theories.",
  },
];

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Play Game", href: "/play-game" },
];

const pageUrl = absoluteUrl("/play-game");
const { "@context": _wp, ...webPageNode } = buildWebPageSchema({
  pageUrl,
  title: seo.title,
  description: seo.description,
  image: "/images/play-game/tadc-mind-games-preview.webp",
});
const { "@context": _fq, ...faqNode } = buildFaqSchema(faqItems);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [webPageNode, faqNode],
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  image="/images/play-game/tadc-mind-games-preview.webp"
  imageAlt="TADC Mind Games fan game preview for The Amazing Digital Circus"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <div class="circus-page page-play-game">
    <section class="page-hero page-hero--game">
      <div class="container">
        <article class="game-page-hero">
          <figure class="game-page-hero-visual">
            <img
              src="/images/play-game/tadc-mind-games-preview.webp"
              alt="TADC Mind Games fan game preview"
              width="640"
              height="360"
              loading="eager"
            />
            <span class="game-page-badge">Horror VN · Browser H5</span>
          </figure>
          <div class="game-page-hero-copy">
            <p class="page-hero-kicker">Fan-made · Inspired by The Amazing Digital Circus</p>
            <h1>The Amazing Digital Circus Game — Play Game</h1>
            <p class="game-page-lede">
              Step into TADC Mind Games, follow the wrong-looking doors, and use the route hub when Caine starts making every answer feel unsafe. Play here, then open the full walkthrough on our dedicated game site.
            </p>
            <ul class="game-page-tags" aria-label="Game tags">
              {gameTags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <dl class="game-page-facts" aria-label="Game quick facts">
              <div><dt>Format</dt><dd>Horror visual novel</dd></div>
              <div><dt>Platform</dt><dd>Browser H5</dd></div>
              <div><dt>Endings</dt><dd>5 known routes</dd></div>
              <div><dt>Status</dt><dd>Unofficial fan game</dd></div>
            </dl>
            <div class="game-page-hero-actions">
              <a class="game-page-jump" href="#play">Play on this page ↓</a>
              <a class="detail-cta-link" href={gameHub} target="_blank" rel="noopener noreferrer">
                Full route hub on tadcmindgames.org →
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="play-game-stage-section" id="play">
      <div class="container">
        <div class="play-game-stage" data-game-stage>
          <div class="play-game-frame">
            <iframe
              title="TADC Mind Games browser game"
              data-src="https://itch.io/embed-upload/17780938?color=0b0710"
              src="about:blank"
              allow="fullscreen; autoplay; gamepad *"
              allowfullscreen
              loading="eager"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <div class="play-game-mask" data-game-mask>
              <div class="play-game-mask-backdrop" aria-hidden="true"></div>
              <div class="play-game-mask-panel">
                <img
                  src="/images/play-game/tadc-mind-games-preview.webp"
                  alt="TADC Mind Games play preview"
                  width="320"
                  height="180"
                  loading="eager"
                />
                <button class="play-game-button" type="button" data-play-button aria-label="Play TADC Mind Games">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5.6v12.8L18.4 12 8 5.6Z"></path>
                  </svg>
                  Play Game
                </button>
                <p>Press to load the itch.io embed — no autoplay until you choose to start.</p>
              </div>
            </div>
          </div>
          <div class="play-game-toolbar">
            <div class="play-game-status" data-game-status>Ready to load</div>
            <div class="play-game-actions" aria-label="Game display controls">
              <button type="button" data-fullscreen aria-label="Fullscreen game frame">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 9V4h5v2H6v3H4Zm11-3V4h5v5h-2V6h-3Zm3 9h2v5h-5v-2h3v-3ZM6 18h3v2H4v-5h2v3Z"></path>
                </svg>
              </button>
              <button type="button" data-web-fullscreen aria-label="Toggle web fullscreen mode">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 5h14v14H5V5Zm2 2v10h10V7H7Zm2 2h6v6H9V9Z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
        <p class="play-game-trust">
          <strong>Editorial note:</strong> TADC Mind Games is a fan-made title inspired by
          <em>The Amazing Digital Circus</em>. It is not official canon. For deep route notes, endings, and choice breakdowns maintained by the same team, use
          <a href={gameHub} target="_blank" rel="noopener noreferrer">tadcmindgames.org</a>.
        </p>
      </div>
    </section>

    <section class="inner-section">
      <div class="container">
        <header class="inner-section-header">
          <p>Game route hub</p>
          <h2>Routes, endings, and dangerous choices in one place</h2>
        </header>
        <p class="play-game-section-lede">
          Jump from the embed into walkthrough help, ending trackers, choice signals, and version updates on our dedicated TADC Mind Games site — without digging through scattered posts.
        </p>
        <div class="play-game-hub">
          {routeHubLinks.map((item) => (
            <a class="play-game-hub-card neon-panel" href={item.href} target="_blank" rel="noopener noreferrer">
              <span class="play-game-hub-tag">{item.tag}</span>
              <strong>{item.label}</strong>
              <p>{item.desc}</p>
              <span class="play-game-hub-go">Open on tadcmindgames.org →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="inner-section">
      <div class="container">
        <header class="inner-section-header">
          <p>Quick start</p>
          <h2>A compact route plan for your first four runs</h2>
        </header>
        <div class="play-game-steps">
          {quickSteps.map((step) => (
            <article class="play-game-step neon-panel">
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="inner-section">
      <div class="container">
        <header class="inner-section-header">
          <p>Choice route map</p>
          <h2>Every answer pushes the game toward pressure, panic, trust, or collapse</h2>
        </header>
        <div class="play-game-route-map neon-panel">
          <p class="play-game-route-map-start">Enter the Digital Circus</p>
          <div class="play-game-route-map-branch">
            {routeBranches.map((branch) => (
              <a href={branch.href} target="_blank" rel="noopener noreferrer">{branch.label}</a>
            ))}
          </div>
          <p class="play-game-route-map-end">Ending path unknown until mood stays consistent</p>
          <a class="detail-cta-link" href={`${gameHub}/choices`} target="_blank" rel="noopener noreferrer">
            Full choice guide on tadcmindgames.org →
          </a>
        </div>
      </div>
    </section>

    <section class="inner-section">
      <div class="container">
        <header class="inner-section-header">
          <p>Ending tracker</p>
          <h2>Five routes, five different kinds of bad idea</h2>
        </header>
        <div class="play-game-table-wrap neon-panel">
          <table class="play-game-table">
            <thead>
              <tr>
                <th scope="col">Ending path</th>
                <th scope="col">Route focus</th>
                <th scope="col">Danger</th>
                <th scope="col">Choice cue</th>
              </tr>
            </thead>
            <tbody>
              {endings.map((ending) => (
                <tr>
                  <th scope="row">{ending.name}</th>
                  <td>{ending.focus}</td>
                  <td>{ending.danger}</td>
                  <td>{ending.cue}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="play-game-table-note">
          Chasing order most players use: Caine trust → Caine defiance → Pomni support → Kinger curiosity → mixed choices.
          <a href={`${gameHub}/endings`} target="_blank" rel="noopener noreferrer">See ending details on tadcmindgames.org</a>.
        </p>
      </div>
    </section>

    <section class="inner-section">
      <div class="container">
        <header class="inner-section-header">
          <p>Current cast</p>
          <h2>Three characters shape most of the danger</h2>
        </header>
        <div class="play-game-routes">
          {characterRoutes.map((character) => (
            <article class="play-game-route-card neon-panel">
              <figure>
                <img src={character.image} alt={character.alt} width="400" height="225" loading="lazy" />
              </figure>
              <div class="play-game-route-body">
                <p>{character.label}</p>
                <h3>{character.name}</h3>
                <span>{character.text}</span>
                <div class="play-game-route-links">
                  <a class="detail-cta-link" href={character.canonHref}>TADC canon profile</a>
                  <a class="detail-cta-link" href={character.gameHref} target="_blank" rel="noopener noreferrer">Game route file →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="inner-section">
      <div class="container">
        <header class="inner-section-header">
          <p>Choice matrix</p>
          <h2>Read the mood before you read the line</h2>
        </header>
        <div class="play-game-signals">
          {choiceSignals.map((item) => (
            <article class="play-game-signal neon-panel">
              <strong>{item.title}</strong>
              <span>{item.signal}</span>
              <em>{item.when}</em>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <p class="play-game-table-note">
          <a href={`${gameHub}/choices`} target="_blank" rel="noopener noreferrer">Open the full choice matrix on tadcmindgames.org</a>
          for scene-level examples and replay notes.
        </p>
      </div>
    </section>

    <section class="inner-section play-game-bridge-section">
      <div class="container">
        <div class="play-game-bridge-grid">
          <article class="play-game-bridge neon-panel">
            <p class="page-hero-kicker">Canon context</p>
            <h2>How the fan game connects to the official show</h2>
            <div class="play-game-bridge-copy">
              <p>
                TADC Mind Games borrows Caine's cheerful control, Pomni's escape panic, and Kinger's fear-and-clue logic from the animation. Our episode and Explained pages keep canon facts separate from fan-game speculation.
              </p>
              <p>
                Recommended canon reading before or after a run:
                <a href="/episodes/pilot">Pilot</a>,
                <a href="/explained/episode-1-pilot-explained">Episode 1 Explained</a>,
                <a href="/episodes/the-mystery-of-mildenhall-manor">Mildenhall Manor</a>, and
                <a href="/guides/the-amazing-digital-circus-ending-explained">the finale ending article</a>.
              </p>
            </div>
            <div class="play-game-bridge-links">
              <a class="detail-cta-link" href="/episodes">All episodes</a>
              <a class="detail-cta-link" href="/characters">Character profiles</a>
              <a class="detail-cta-link" href={`${gameHub}/related-games`} target="_blank" rel="noopener noreferrer">Related horror games →</a>
            </div>
          </article>
          <article class="play-game-faq neon-panel">
            <p class="page-hero-kicker">FAQ</p>
            <h2>TADC Mind Games questions players ask first</h2>
            <div class="play-game-faq-list">
              {faqItems.map((item, index) => (
                <details open={index === 0}>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>

  <script>
    const gameStage = document.querySelector("[data-game-stage]");
    const gameIframe = gameStage?.querySelector("iframe");
    const playButton = gameStage?.querySelector("[data-play-button]");
    const gameMask = gameStage?.querySelector("[data-game-mask]");
    const gameStatus = gameStage?.querySelector("[data-game-status]");
    const fullscreenButton = gameStage?.querySelector("[data-fullscreen]");
    const webFullscreenButton = gameStage?.querySelector("[data-web-fullscreen]");
    let gameLoaded = false;

    const loadGame = () => {
      if (!gameIframe || gameLoaded) return;
      gameIframe.setAttribute("src", gameIframe.getAttribute("data-src") || "about:blank");
      gameLoaded = true;
      gameStage?.classList.add("is-playing");
      gameMask?.setAttribute("aria-hidden", "true");
      if (gameStatus) gameStatus.textContent = "Game loaded";
    };

    playButton?.addEventListener("click", loadGame);

    fullscreenButton?.addEventListener("click", async () => {
      loadGame();
      const frame = gameStage?.querySelector(".play-game-frame");
      if (frame && "requestFullscreen" in frame) {
        await frame.requestFullscreen();
      }
    });

    webFullscreenButton?.addEventListener("click", () => {
      loadGame();
      gameStage?.classList.toggle("is-web-fullscreen");
      document.body.classList.toggle("is-game-expanded", gameStage?.classList.contains("is-web-fullscreen"));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && gameStage?.classList.contains("is-web-fullscreen")) {
        gameStage.classList.remove("is-web-fullscreen");
        document.body.classList.remove("is-game-expanded");
      }
    });
  </script>
</BaseLayout>
