---
import BrandWordmark from "./BrandWordmark.astro";
import { brandLogo, brandTitle, mainNavigation } from "../seo/siteSeo.js";

const currentPath = Astro.url.pathname;
---

<header class="app-header">
  <div class="container">
  <div class="marquee-line" aria-hidden="true"></div>
    <div class="header-shell">
      <a class="brand-link" href="/" aria-label={`${brandTitle} home`}>
        <img
          class="brand-mark"
          src={brandLogo}
          alt=""
          width="42"
          height="42"
        />
        <BrandWordmark />
      </a>

      <input class="nav-toggle" id="primary-nav-toggle" type="checkbox" aria-label="Toggle primary navigation" />
      <label class="nav-menu-button" for="primary-nav-toggle" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </label>

      <nav class="site-nav" aria-label="Primary navigation">
        {mainNavigation.map((item) => (
          <a class:list={["nav-link", currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "is-active" : ""]} href={item.href}>
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
